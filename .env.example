# Supabase — copy this file to .env.local and fill in your project values.
# The site runs fine without them: it falls back to the bundled seed data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key, used by the contact form route to insert leads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
